var ws := WebSocketPeer.new()

func _ready() -> void:
	ws.connect_to_url(ServerData.SERVERS[0].ws_addr)
	Postcard.start_encode()
	
	#ws.send()

func _process(_delta: float) -> void:
	ws.poll()
	
	
	match ws.get_ready_state():
		WebSocketPeer.STATE_OPEN:
			pass
		WebSocketPeer.STATE_CLOSED:
			pass
"

