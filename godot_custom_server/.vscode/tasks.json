{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Editor Internal",
      "type": "shell",
      "hide": true,
      "command": "scons",
      "args": [
        "-C",
        "../godot",
        "custom_modules=../godot_custom_server",
        "compiledb=yes"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Make Directory",
      "type": "shell",
      "hide": true,
      "command": "mkdir",
      "args": [
        "-p",
        "../bin/server"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Mv Compiledb",
      "type": "shell",
      "hide": true,
      "command": "mv",
      "args": [
        "../godot/compile_commands.json",
        "../godot_custom_server"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Mv Bin",
      "type": "shell",
      "hide": true,
      "command": "mv",
      "args": [
        "../godot/bin/*",
        "../bin/server/"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Launch Editor",
      "type": "shell",
      "problemMatcher": [],
      "windows": {
        "command": "..\\bin\\server\\godot.windows.editor.x86_64.exe",
        "args": [
          "--editor",
          "--path",
          "../server"
        ]
      },
      "linux": {
        "command": "../bin/server/godot.linuxbsd.editor.x86_64",
        "args": [
          "--editor",
          "--path",
          "../server"
        ]
      },
      "osx": {
        "command": "../bin/server/godot.osx.editor.x86_64",
        "args": [
          "--editor",
          "--path",
          "../server"
        ]
      }
    },
    {
      "label": "Build Editor",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Editor Internal",
        "Make Directory",
        "Mv Bin",
        "Mv Compiledb"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build and Launch Editor",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Editor",
        "Launch Editor"
      ],
      "problemMatcher": []
    },
  ]
}